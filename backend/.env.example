# Local Model Configuration
DEFAULT_MODEL=llama3.2:3b

# Active Prompt Version (v1, v2)
PROMPT_VERSION=v2

# Cost & Token Tracking Toggle (true / false)
LOG_COSTS=true

# Ollama Endpoint URL
# Use http://localhost:11434 when running natively on host
# Use http://host.docker.internal:11434 when running inside Docker container
OLLAMA_BASE_URL=http://localhost:11434

# Optional Placeholder API Key
OPENAI_API_KEY=local
